{
  "name": "rong-studio",
  "productName": "Rong Studio",
  "version": "2.1.0",
  "description": "Rong Studio: picture text and design editor",
  "main": "main.js",
  "author": "Rong Studio",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.rongstudio.desktop",
    "productName": "Rong Studio",
    "asar": false,
    "files": ["main.js", "preload.js", "icon.png", "assets/**/*"],
    "directories": { "output": "dist" },
    "fileAssociations": [{ "ext": ["png", "jpg", "jpeg", "webp"], "name": "Image", "role": "Editor" }],
    "win": { "target": ["nsis", "portable"], "icon": "icon.png" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rong Studio",
      "artifactName": "RongStudio-Setup-${version}.exe"
    },
    "portable": { "artifactName": "RongStudio-Portable-${version}.exe" },
    "mac": { "target": ["dmg"], "icon": "icon.png", "category": "public.app-category.graphics-design", "artifactName": "RongStudio-${version}.dmg" },
    "linux": { "target": ["AppImage"], "icon": "icon.png", "category": "Graphics", "artifactName": "RongStudio-${version}.AppImage" }
  }
}
